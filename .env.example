# Database Connection URL used by the web app (points to the existing database server)
# For local Docker Desktop testing against a host database, use "host.docker.internal:5432"
DATABASE_URL=postgresql+asyncpg://your_database_user:your_database_password@host.docker.internal:5432/your_database_name

# Application Server Listening Port (change if another app is using 8001)
PORT=8001

# WhatsApp Client Type Configuration (meta_cloud for production, mock for local testing)
WHATSAPP_CLIENT_TYPE=meta_cloud

# Live Meta Cloud API credentials (leave empty if using client type "mock")
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App Secret used to verify incoming Webhook signature headers (X-Hub-Signature-256)
META_APP_SECRET=

# JWT Authentication Security Secret Key
# Generate a secure random key in PowerShell/Terminal using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_secret_in_production

# CORS Security Setup: Comma-separated list of allowed HTTP(S) domains (leave empty for safe dev defaults)
ALLOWED_ORIGINS=https://whatsapp.college.edu

# Public App Base URL: Sets a fixed domain base for building Meta media outreach resources, preventing host header poisoning
PUBLIC_APP_URL=https://whatsapp.college.edu